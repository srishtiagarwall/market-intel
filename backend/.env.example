# ── Database (Neon) ───────────────────────────────────────────────────────────
# Get from: console.neon.tech → your project → Connection Details
# Choose "Connection string" → select driver "node-postgres / psycopg2" for the sync URL
# and "asyncpg" for the async URL.
#
# Async driver used by FastAPI (SSL is auto-enabled for any non-localhost host)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/market_intel
# Sync driver used by Alembic migrations only
DATABASE_URL_SYNC=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/market_intel?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional in development — leave empty to skip Redis entirely (no Docker needed).
# App will fetch live data on every request instead of using cache.
REDIS_URL=

# ── External APIs ─────────────────────────────────────────────────────────────
# Get from newsapi.org (free tier = 100 req/day)
NEWSAPI_KEY=your_newsapi_key_here

# Log into screener.in → DevTools → Application → Cookies → copy "sessionid"
SCREENER_SESSION_COOKIE=your_screener_session_id_here

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# Message @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Message your bot once → GET https://api.telegram.org/bot<TOKEN>/getUpdates → find chat.id
TELEGRAM_CHAT_ID=your_chat_id_here

# ── App Config ────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Signal Thresholds (tune after backtesting) ────────────────────────────────
# MF composite score >= this → CONSIDER signal (default 60, update after backtest)
MF_SIGNAL_THRESHOLD=60
# Stock composite score >= this → BUY signal (default 70, update after backtest)
STOCK_SIGNAL_THRESHOLD=70

# ── Scoring Weights ───────────────────────────────────────────────────────────
# MF component max scores (must sum to 100)
MF_DRAWDOWN_MAX=40
MF_VALUATION_MAX=40
MF_MACRO_MAX=20

# Stock component weights (must sum to 1.0)
STOCK_FUNDAMENTAL_WEIGHT=0.4
STOCK_TECHNICAL_WEIGHT=0.4
STOCK_EVENT_WEIGHT=0.2

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
PRICE_CACHE_TTL=300
SIGNAL_CACHE_TTL=3600
